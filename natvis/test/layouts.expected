@@ layouts.goose:25 main_g
-- dx -r1 second_g
second_g         : 0x_ : PNode { v: 2, next: PNode { v: 1, next: null } } [Type: PNode_g *]
    [<Raw View>]     [Type: PNode_g]
    v                : 2 [Type: __int64]
    next             : PNode { v: 1, next: null } [Type: PNode_g]
-- dx -r1 sized_g
sized_g          : 0x_ : 0x8 [Type: unsigned char *]
    0x8 [Type: unsigned char]
-- dx -r1 short_g
short_g          : 0x_ : 0x2 [Type: unsigned char *]
    0x2 [Type: unsigned char]
-- dx -r1 c_g
c_g              : 0x_ : 0x0 [Type: unsigned char *]
    0x0 [Type: unsigned char]
-- dx -r1 fs_g
fs_g             : [Shape.Dot, Shape.Dot, Shape.Dot, Shape.Dot] [Type: a4_Shape_g]
    [<Raw View>]     [Type: a4_Shape_g]
    [0]              : Shape.Dot [Type: Shape_g]
    [1]              : Shape.Dot [Type: Shape_g]
    [2]              : Shape.Dot [Type: Shape_g]
    [3]              : Shape.Dot [Type: Shape_g]
-- dx -r1 r_g
r_g              : 0x_ : 0xa [Type: unsigned char *]
    0xa [Type: unsigned char]
-- dx -r1 count_g
count_g          : 1 [Type: __int64]
-- dx -r1 cur_g
cur_g            : Cursor { line: 1, flag: true } [Type: Cursor_g]
    [<Raw View>]     [Type: Cursor_g]
    line             : 1 [Type: __int64]
    flag             : true [Type: bool]
-- dx -r1 gs_globals_main
gs_globals_main  : globals { pool: [PNode { v: 1, next: null }, PNode { v: 2, next: PNode { v: 1, next: null } }], log: "x" } [Type: gs_globals_t]
    [<Raw View>]     [Type: gs_globals_t]
    pool             : [PNode { v: 1, next: null }, PNode { v: 2, next: PNode { v: 1, next: null } }]
    log              : "x"
-- !goose_locals
second: PNode& = PNode { v: 2, next: PNode { v: 1, next: null } }
sized: i64[..] = [3]
short: u8[varint] = "hi"
c: Shape.. = Shape.Circle { r: 2.0 }
fs: Shape[4] = [Shape.Dot, Shape.Dot, Shape.Dot, Shape.Dot]
r: Rec = Rec { id: 5, tag: "ab" }
count: i64 = 1
cur: Cursor = Cursor { line: 1, flag: true }
-- !goose_globals
pool: PNode[>..] = [PNode { v: 1, next: null }, PNode { v: 2, next: PNode { v: 1, next: null } }]
log: u8[>..] = "x"
