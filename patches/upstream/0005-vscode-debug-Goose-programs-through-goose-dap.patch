new file mode 100644
index 00000000..929fa2d3
--- /dev/null
+++ b/vscode/test/debug.test.js
@@ -0,0 +1,256 @@
+'use strict';
+
+// Debugging: the configurations offered, how a `goose` launch configuration
+// resolves (Run with JIT, or a session of goose-dap), the search for
+// goose-dap, the probe of the compiler for -g, and the debug adapter factory.
+// The extension itself is activated against a stub of the VS Code API.
+
+const assert = require('node:assert/strict');
+const test = require('node:test');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const {
+    findAdapter, supportsDebugInfo, probeDebugInfo, executableFor, adapterConfiguration,
+    descriptorFactory, launchConfigurations, messages
+} = require('../src/debug');
+const { activated } = require('./vscode-stub');
+
+const windows = process.platform === 'win32';
+
+function scratch() {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'goose vscode debug '));
+    return { dir, remove: () => fs.rmSync(dir, { recursive: true, force: true }) };
+}
+
+// An executable script: a stand-in for the compiler or goose-dap.
+function script(file, body) {
+    if (windows) {
+        fs.writeFileSync(`${file}.cmd`, `@echo off\r\n${body.replace(/^echo '(.*)'$/gm, 'echo $1')}\r\n`);
+        return `${file}.cmd`;
+    }
+    fs.writeFileSync(file, `#!/bin/sh\n${body}\n`, { mode: 0o755 });
+    return file;
+}
+
+const PATCHED_HELP = 'usage: goose build file.goose [options]\n  -g, --debug-info      --debug, and the C built for stepping\n';
+const UPSTREAM_HELP = 'usage: goose build file.goose [options]\n  --debug               Overflow, range and tag checks\n';
+
+test('the configurations offered: Run with JIT, as before, and Debug', () => {
+    assert.deepEqual(launchConfigurations(), [
+        { type: 'goose', request: 'launch', name: 'Goose: Run with JIT', noDebug: true },
+        { type: 'goose', request: 'launch', name: 'Goose: Debug' }
+    ]);
+    const pkg = require('../package.json');
+    const debuggers = pkg.contributes.debuggers;
+    assert.equal(debuggers.length, 1);
+    assert.equal(debuggers[0].type, 'goose');
+    assert.deepEqual(debuggers[0].initialConfigurations, launchConfigurations());
+    assert.deepEqual(debuggers[0].configurationSnippets.map(s => s.body), launchConfigurations());
+    assert.deepEqual(pkg.contributes.breakpoints, [{ language: 'goose' }]);
+    const settings = pkg.contributes.configuration.properties;
+    for (const key of ['goose.debugAdapterPath', 'goose.lldbDapPath']) {
+        assert.equal(settings[key].default, '');
+        assert.ok(pkg.capabilities.untrustedWorkspaces.restrictedConfigurations.includes(key), key);
+    }
+    assert.ok(pkg.contributes.commands.some(c => c.command === 'goose.debug'));
+    assert.ok(pkg.contributes.menus['editor/title'].some(m => m.command === 'goose.debug'));
+    // F5 in a Goose editor keeps running with the JIT while the setting is on.
+    const f5 = pkg.contributes.keybindings.find(k => k.key === 'f5');
+    assert.equal(f5.command, 'goose.run');
+    assert.match(f5.when, /config\.goose\.useRunKeybindings/);
+});
+
+test('-g is found in the help of goose build', async () => {
+    assert.equal(supportsDebugInfo(PATCHED_HELP), true);
+    assert.equal(supportsDebugInfo(UPSTREAM_HELP), false);
+    assert.equal(supportsDebugInfo(undefined), false);
+    const spawn = (help, code) => (command, args, options, callback) => {
+        assert.deepEqual(args, ['help', 'build']);
+        assert.equal(options.cwd, 'work');
+        callback(code ? Object.assign(new Error('failed'), { code }) : null, help, '');
+    };
+    assert.deepEqual(await probeDebugInfo('goose', 'work', spawn(PATCHED_HELP)), { found: true, debugInfo: true });
+    assert.deepEqual(await probeDebugInfo('goose', 'work', spawn(UPSTREAM_HELP)), { found: true, debugInfo: false });
+    assert.deepEqual(await probeDebugInfo('goose', 'work', spawn('', 1)), { found: true, debugInfo: false });
+    assert.deepEqual(await probeDebugInfo('goose', 'work', spawn('', 'ENOENT')), { found: false, debugInfo: false });
+});
+
+test('goose-dap is goose.debugAdapterPath, or the first on PATH', () => {
+    const { dir, remove } = scratch();
+    try {
+        const bin = path.join(dir, 'bin');
+        const tools = path.join(dir, 'tools');
+        fs.mkdirSync(bin);
+        fs.mkdirSync(tools);
+        const onPath = path.join(bin, windows ? 'goose-dap.cmd' : 'goose-dap');
+        fs.writeFileSync(onPath, '');
+        fs.writeFileSync(path.join(tools, 'goose-dap'), '');
+        const env = { PATH: [path.join(dir, 'missing'), bin].join(path.delimiter) };
+        assert.equal(findAdapter('', dir, env), onPath);
+        assert.equal(findAdapter('tools/goose-dap', dir, env), path.join(tools, 'goose-dap'));
+        assert.equal(findAdapter('${workspaceFolder}/tools/goose-dap', dir, env), path.join(tools, 'goose-dap'));
+        // A setting that names nothing is not replaced by PATH's.
+        assert.equal(findAdapter('tools/none', dir, env), undefined);
+        assert.equal(findAdapter('', dir, { PATH: path.join(dir, 'missing') }), undefined);
+        // A directory is not the adapter.
+        assert.equal(findAdapter('tools', dir, env), undefined);
+    } finally { remove(); }
+});
+
+test('goose-dap gets the entry file as source, the executable beside it, and the settings', () => {
+    const source = path.resolve('w', 'src', 'main.goose');
+    const resolved = { source, compiler: '/c/goose', cwd: path.resolve('w'), stdlib: '', runArguments: ['a b'], lldbDap: '' };
+    const config = adapterConfiguration({ type: 'goose', request: 'launch', name: 'Goose: Debug', program: source }, resolved, 'darwin');
+    assert.deepEqual(config, {
+        type: 'goose', request: 'launch', name: 'Goose: Debug',
+        source, program: path.resolve('w', 'src', 'main'), build: true, goose: '/c/goose',
+        cwd: path.resolve('w'), args: ['a b'], env: {}
+    });
+    assert.equal(executableFor('C:/w/main.goose', 'win32'), 'C:/w/main.exe');
+    // What the configuration sets wins; goose.stdlibPath and buildArgs go to
+    // goose build; anything else goes on to goose-dap as written.
+    const custom = adapterConfiguration({
+        type: 'goose', request: 'launch', name: 'Mine', program: source, args: [], cwd: 'run',
+        env: { A: '1' }, buildArgs: ['-O1'], lldbDap: '/x/lldb-dap', stopOnEntry: true, showRuntimeFrames: true,
+        stopOnRuntimeError: false, initCommands: ['bt']
+    }, { ...resolved, stdlib: '/s/stdlib', lldbDap: '/y/lldb-dap' }, 'linux');
+    assert.deepEqual(custom, {
+        type: 'goose', request: 'launch', name: 'Mine', source, program: path.resolve('w', 'src', 'main'),
+        build: true, goose: '/c/goose', cwd: path.resolve('w', 'run'), args: [], env: { A: '1' },
+        buildArgs: ['--stdlib', '/s/stdlib', '-O1'], lldbDap: '/x/lldb-dap', stopOnEntry: true,
+        showRuntimeFrames: true, stopOnRuntimeError: false, initCommands: ['bt']
+    });
+    assert.equal(adapterConfiguration({}, resolved, 'darwin').name, 'Goose: Debug');
+    assert.equal(adapterConfiguration({}, { ...resolved, lldbDap: '/y/lldb-dap' }, 'darwin').lldbDap, '/y/lldb-dap');
+});
+
+test('the debug adapter factory runs goose-dap over stdio, or says where to get it', () => {
+    class DebugAdapterExecutable { constructor(command, args, options) { Object.assign(this, { command, args, options }); } }
+    const factory = descriptorFactory({ DebugAdapterExecutable }, session => session.found);
+    const descriptor = factory.createDebugAdapterDescriptor({ found: '/opt/goose-dap' });
+    assert.ok(descriptor instanceof DebugAdapterExecutable);
+    assert.equal(descriptor.command, '/opt/goose-dap');
+    assert.deepEqual(descriptor.args, []);
+    assert.throws(() => factory.createDebugAdapterDescriptor({ found: undefined }), /goose\.debugAdapterPath/);
+});
+
+// --- the extension, activated against a stub of the VS Code API ---------
+
+function workspace(helpText, withAdapter = true) {
+    const { dir, remove } = scratch();
+    const compiler = script(path.join(dir, 'goose'), helpText.split('\n').filter(Boolean).map(line => `echo '${line}'`).join('\n'));
+    fs.writeFileSync(path.join(dir, 'main.goose'), 'fn main() { print(1); }\n');
+    const adapter = path.join(dir, 'goose-dap');
+    if (withAdapter) fs.writeFileSync(adapter, '');
+    const folder = { uri: { fsPath: dir, scheme: 'file', toString: () => `file://${dir}` }, name: 'w', index: 0 };
+    return { dir, remove, compiler, adapter, folder };
+}
+
+test('a goose configuration with noDebug runs with the JIT, as before', async () => {
+    const w = workspace(PATCHED_HELP);
+    try {
+        const values = { compilerPath: w.compiler, entryFile: 'main.goose', useLanguageServer: false, checkOnSave: false };
+        const { seen, provider, context, extension } = await activated({ folder: w.folder, values });
+        try {
+            assert.deepEqual(await provider.provideDebugConfigurations(w.folder), launchConfigurations());
+            const config = provider.resolveDebugConfiguration(w.folder, { noDebug: true });
+            assert.deepEqual(config, { type: 'goose', request: 'launch', name: 'Goose: Run with JIT', noDebug: true });
+            assert.equal(await provider.resolveDebugConfigurationWithSubstitutedVariables(w.folder, config), undefined);
+            assert.equal(seen.tasks.length, 1);
+            const task = seen.tasks[0];
+            assert.equal(task.definition.action, 'run');
+            assert.equal(task.execution.process, w.compiler);
+            assert.deepEqual(task.execution.args, ['--jit', path.join(w.dir, 'main.goose')]);
+            assert.deepEqual(seen.errors, []);
+        } finally { context.subscriptions.forEach(d => d.dispose?.()); await extension.deactivate(); }
+    } finally { w.remove(); }
+});
+
+test('a goose configuration without noDebug is a goose-dap session that builds with -g', async () => {
+    const w = workspace(PATCHED_HELP);
+    try {
+        const values = {
+            compilerPath: w.compiler, entryFile: 'main.goose', useLanguageServer: false, checkOnSave: false,
+            debugAdapterPath: '${workspaceFolder}/goose-dap', lldbDapPath: 'tools/lldb-dap', runArguments: ['x']
+        };
+        const { vscode, seen, provider, context, extension } = await activated({ folder: w.folder, values });
+        try {
+            // F5 with no launch.json: an empty configuration.
+            const config = provider.resolveDebugConfiguration(w.folder, {});
+            assert.deepEqual(config, { type: 'goose', request: 'launch', name: 'Goose: Debug' });
+            const resolved = await provider.resolveDebugConfigurationWithSubstitutedVariables(w.folder, config);
+            assert.deepEqual(seen.errors, []);
+            assert.equal(seen.tasks.length, 0, 'a debug session runs no JIT task');
+            const source = path.join(w.dir, 'main.goose');
+            assert.deepEqual(resolved, {
+                type: 'goose', request: 'launch', name: 'Goose: Debug',
+                source, program: executableFor(source), build: true, goose: w.compiler,
+                cwd: w.dir, args: ['x'], env: {}, lldbDap: path.join(w.dir, 'tools', 'lldb-dap')
+            });
+            // The factory serves that session with goose-dap.
+            assert.equal(seen.factories.length, 1);
+            assert.equal(seen.factories[0].type, 'goose');
+            const descriptor = seen.factories[0].factory.createDebugAdapterDescriptor({ workspaceFolder: w.folder, configuration: resolved });
+            assert.equal(descriptor.command, w.adapter);
+            assert.deepEqual(descriptor.args, []);
+            // A configuration's program is the Goose file to build.
+            const other = path.join(w.dir, 'other.goose');
+            fs.writeFileSync(other, 'fn main() {}\n');
+            const explicit = await provider.resolveDebugConfigurationWithSubstitutedVariables(w.folder,
+                { type: 'goose', request: 'launch', name: 'Other', program: other, args: ['y'], stopOnEntry: true });
+            assert.equal(explicit.source, other);
+            assert.equal(explicit.program, executableFor(other));
+            assert.deepEqual(explicit.args, ['y']);
+            assert.equal(explicit.stopOnEntry, true);
+            // Goose: Debug starts the session in the file's folder.
+            // Goose: Debug starts a session in the active file's folder, which
+            // resolves the entry file as above.
+            vscode.window.activeTextEditor = { document: { languageId: 'goose', uri: vscode.Uri.file(other), isDirty: false, isUntitled: false } };
