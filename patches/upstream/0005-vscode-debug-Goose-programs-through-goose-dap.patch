index 00000000..bad77ed0
--- /dev/null
+++ b/vscode/src/debug.js
@@ -0,0 +1,118 @@
+'use strict';
+
+// Debugging a Goose program: the configuration a launch hands the debug
+// adapter, goose-dap (goose-debugger.git's dap/goose-dap), a Debug Adapter
+// Protocol proxy in front of LLDB's lldb-dap that builds the program with
+// `goose build -g` and shows it at the Goose level. Nothing here needs the
+// editor, so it is tested with plain Node.
+
+const fs = require('node:fs');
+const path = require('node:path');
+const { execFile } = require('node:child_process');
+const { expand } = require('./config');
+
+const ADAPTER = 'goose-dap';
+
+// Where goose-dap is: goose.debugAdapterPath when set (relative to the
+// folder, with ${workspaceFolder}), else the first goose-dap on PATH.
+// Undefined when there is none.
+function findAdapter(configured, folder, env = process.env, platform = process.platform) {
+    const isFile = file => { try { return fs.statSync(file).isFile(); } catch { return false; } };
+    if (configured) {
+        const file = path.resolve(folder, expand(configured, folder, ''));
+        return isFile(file) ? file : undefined;
+    }
+    const names = platform === 'win32' ? [`${ADAPTER}.exe`, `${ADAPTER}.cmd`, `${ADAPTER}.bat`, ADAPTER] : [ADAPTER];
+    for (const dir of (env.PATH || env.Path || '').split(path.delimiter)) {
+        if (!dir) continue;
+        for (const name of names) {
+            const file = path.resolve(dir, name);
+            if (isFile(file)) return file;
+        }
+    }
+    return undefined;
+}
+
+// Whether a compiler builds for a debugger: `goose help build` lists -g,
+// --debug-info where the compiler has it.
+function supportsDebugInfo(helpText) {
+    return /--debug-info\b/.test(String(helpText || ''));
+}
+
+function probeDebugInfo(compiler, cwd, spawn = execFile) {
+    return new Promise(resolve => {
+        spawn(compiler, ['help', 'build'], { cwd, timeout: 10000, windowsHide: true, encoding: 'utf8', shell: false },
+            (error, stdout, stderr) => {
+                if (error && error.code === 'ENOENT') resolve({ found: false, debugInfo: false });
+                else resolve({ found: true, debugInfo: supportsDebugInfo(`${stdout || ''}${stderr || ''}`) });
+            });
+    });
+}
+
+// The executable a debug build writes: beside the source, as `goose build`
+// and the Build Executable task put it.
+function executableFor(source, platform = process.platform) {
+    const stem = source.replace(/\.goose$/, '');
+    return platform === 'win32' ? `${stem}.exe` : stem;
+}
+
+// The launch configuration goose-dap gets for a Goose launch configuration
+// `config` (whose `program` is the Goose entry file, as for Run with JIT)
+// and the resolved settings: the entry file `source`, the compiler, the
+// working directory, the standard library, the program arguments and
+// lldbDapPath. goose-dap builds `program` from `source` with `goose build -g`
+// and debugs it.
+function adapterConfiguration(config, resolved, platform = process.platform) {
+    const { source, compiler, cwd, stdlib, runArguments, lldbDap } = resolved;
+    // What else the configuration sets (stopOnEntry, stopOnRuntimeError,
+    // showRuntimeFrames, initCommands, ...) goes to goose-dap as written, and
+    // through it to lldb-dap.
+    const out = { ...config };
+    const buildArgs = [...(stdlib ? ['--stdlib', stdlib] : []), ...(Array.isArray(config.buildArgs) ? config.buildArgs : [])];
+    Object.assign(out, {
+        type: 'goose',
+        request: 'launch',
+        name: config.name || 'Goose: Debug',
+        source,
+        program: executableFor(source, platform),
+        build: true,
+        goose: compiler,
+        cwd: config.cwd ? path.resolve(cwd, config.cwd) : cwd,
+        args: Array.isArray(config.args) ? config.args : runArguments || [],
+        env: config.env && typeof config.env === 'object' ? config.env : {}
+    });
+    if (buildArgs.length) out.buildArgs = buildArgs;
+    const lldb = config.lldbDap || lldbDap;
+    if (lldb) out.lldbDap = lldb;
+    return out;
+}
+
+const messages = {
+    noAdapter: configured => configured
+        ? `goose-dap was not found at goose.debugAdapterPath (${configured}). Set it to the dap/goose-dap script of goose-debugger, which needs Python 3 and LLDB's lldb-dap.`
+        : 'Debugging Goose needs goose-dap, the Goose debug adapter (dap/goose-dap in goose-debugger, which needs Python 3 and LLDB\'s lldb-dap). Put goose-dap on PATH or set goose.debugAdapterPath to it.',
+    noCompiler: compiler => `Goose compiler not found: ${compiler}. Set goose.compilerPath to the executable.`,
+    noDebugInfo: compiler => `The Goose compiler ${compiler} cannot build for a debugger: \`goose build\` has no -g (--debug-info). Install a compiler with -g (goose-debugger's patches 0001-0007) or point goose.compilerPath to one. Run with JIT works without it.`
+};
+
+// The debug configurations offered: Run with JIT, as before, and Debug.
+const launchConfigurations = () => [
+    { type: 'goose', request: 'launch', name: 'Goose: Run with JIT', noDebug: true },
+    { type: 'goose', request: 'launch', name: 'Goose: Debug' }
+];
+
+// The debug adapter of a session: goose-dap, run over stdio.
+function descriptorFactory(vscode, adapterPath) {
+    return {
+        createDebugAdapterDescriptor(session) {
+            const file = adapterPath(session);
+            if (!file) throw new Error(messages.noAdapter(''));
+            return new vscode.DebugAdapterExecutable(file, []);
+        }
+    };
+}
+
+module.exports = {
+    findAdapter, supportsDebugInfo, probeDebugInfo, executableFor, adapterConfiguration,
