@@ -0,0 +1,103 @@
+'use strict';
+
+// A stub of the VS Code API, enough to activate the extension outside the
+// editor and call what it registers: the debug configuration provider, the
+// debug adapter factory and the commands. What a test does not give is a
+// no-op.
+
+const path = require('node:path');
+const Module = require('node:module');
+
+// Any member not given is a no-op function whose results are no-ops too.
+function stub() {
+    const target = function () {};
+    const cache = new Map();
+    return new Proxy(target, {
+        get(_t, key) {
+            if (key === 'then') return undefined;
+            if (key === Symbol.toPrimitive) return () => '';
+            if (!cache.has(key)) cache.set(key, stub());
+            return cache.get(key);
+        },
+        set(_t, key, value) { cache.set(key, value); return true; },
+        apply() { return stub(); }
+    });
+}
+
+function fakeVscode({ folder, values, trusted = true }) {
