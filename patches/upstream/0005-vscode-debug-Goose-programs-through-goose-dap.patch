+            assert.equal(seen.started.length, 1);
+            assert.equal(seen.started[0].target, w.folder);
+            assert.deepEqual(seen.started[0].config, { type: 'goose', request: 'launch', name: 'Goose: Debug' });
+            // The code lens above a main names its file: that file is debugged.
+            await seen.commands.get('goose.debug')(`file://${other}`);
+            assert.equal(seen.started[1].config.program, other);
+        } finally { context.subscriptions.forEach(d => d.dispose?.()); await extension.deactivate(); }
+    } finally { w.remove(); }
+});
+
+test('debugging says what to install when goose-dap or -g is missing, or the workspace is not trusted', async () => {
+    for (const [help, withAdapter, trusted, expect] of [
+        [PATCHED_HELP, false, true, /Put goose-dap on PATH or set goose\.debugAdapterPath/],
+        [UPSTREAM_HELP, true, true, /cannot build for a debugger.*-g \(--debug-info\)/],
+        [PATCHED_HELP, true, false, /Trust this workspace to debug/]
