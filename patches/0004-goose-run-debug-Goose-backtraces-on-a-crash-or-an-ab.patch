 int goose_jit_run(int (*entry)(int, char **), void (*cleanup)(void),
-                  int argc, char **argv, const char *resource_dir);
+                  int argc, char **argv, const char *resource_dir, void *walk);
 
 #ifdef __cplusplus
 }
