diff --git a/docs/design/jit_backend.md b/docs/design/jit_backend.md
index 6af595ff..a78e64cb 100644
--- a/docs/design/jit_backend.md
+++ b/docs/design/jit_backend.md
@@ -155,11 +155,31 @@ coverage.
 
 ### Backtraces and bounds checking
 
-`config.h` turns off TinyCC's own backtraces and bounds checking, because the
-support objects behind them need the full Windows SDK headers, which TinyCC
-does not ship. A crash inside generated code therefore takes the compiler
-process down with no symbolic stack. Both could be enabled on the ELF and
-Mach-O targets only, where those objects build without `windows.h`.
+`config.h` turns off TinyCC's bounds checking, because the support objects
+behind it need the full Windows SDK headers, which TinyCC does not ship. A
+crash inside generated code therefore takes the compiler process down with
+no symbolic stack, except under `goose run --debug` on the ELF and Mach-O
+targets. There `config.h` turns TinyCC's backtraces on, and `src/jit.h` asks
+for a line table (`-bt64 -g1dwarf`), which the C's `#line` directives make a
+table of Goose lines. A crash reaches TinyCC's signal handler (behind the
+runtime's own, which passes on the faults that are not its data stacks'),
+which walks the frame pointers and hands each frame to `JitFrame`; an abort
+walks the same way from the runtime (`gs_jit_trace`). Both print the
+frames with a `.goose` line, innermost first:
+
+```
+goose runtime error: index 3 out of bounds (length 3) (deep.goose:5)
+  at leaf (deep.goose:5)
+  at middle (deep.goose:9)
+  at main (deep.goose:23)
+```
+
+A crash exits 255 (TinyCC's `rt_exit`) where it would have died by the
+signal, and TinyCC's handlers stay installed in the compiler after the run.
+A fault inside a leaf C function of the host's, such as `memcpy`, loses the
+innermost Goose frame: its return address is in a register, not in a frame
+record. Windows is left out because TinyCC's PE target links `bt-log.o`
+into every in-memory run with backtraces on (`tccpe.c`).
 
 ### macOS
 
diff --git a/src/jit.h b/src/jit.h
index 5d94f30c..8f453762 100644
--- a/src/jit.h
+++ b/src/jit.h
@@ -39,12 +39,71 @@ inline void JitDiag(void *opaque, const char *msg) {
     Append(*(string *)opaque, msg, "\n");
 }
 
+// The name `cname` has in the program: `area_g` and its overload or clone
+// `area_g_2` are `area`, `image_Pixel_g5` is `image::Pixel` (the namespace's
+// length is the digits after the suffix, CodeGen::Sanitize). Anything else,
+// such as a C function of the user's own, keeps its C name.
+inline string JitGooseName(string_view cname) {
+    auto digits = [](string_view s) {
+        for (auto c : s) if (c < '0' || c > '9') return false;
+        return true;
+    };
+    for (auto p = cname.rfind("_g"); p != string_view::npos && p;
+         p = cname.rfind("_g", p - 1)) {
+        auto rest = cname.substr(p + 2);
+        auto nslen = rest.find('_');
+        auto ns = rest.substr(0, nslen);
+        if (!digits(ns)) continue;
+        if (nslen != string_view::npos) {
+            auto clone = rest.substr(nslen + 1);
+            if (clone.empty() || !digits(clone)) continue;
+        }
+        auto base = cname.substr(0, p);
+        size_t n = ns.empty() ? 0 : (size_t)atoi(string(ns).c_str());
+        if (n && n + 1 < base.size() && base[n] == '_')
+            return cat(base.substr(0, n), "::", base.substr(n + 1));
+        return string(base);
+    }
+    return string(cname);
+}
+
+// goose run --debug's backtrace: TinyCC calls this with each frame from where
+// the program crashed (its own signal handler, tccrun.c) or aborted
+// (gs_jit_trace) outwards, the innermost with `msg`, and stops when it
+// returns 0. It prints the frames with a .goose line, and the innermost one
+// whatever its file if it has a line and is not the runtime's (a C function
+// of the user's own, from --include): the runtime has no lines in this
+// process, and gs_ names in the program's C. The walk ends at the C main
+// that called the program's. TinyCC's message for a crash ("RUNTIME ERROR:
+// invalid memory access") becomes a Goose one; an abort's is empty, as
+// gs_fail printed it.
+inline int JitFrame(void *, void *, const char *file, int line, const char *func,
+                    const char *msg) {
+    if (msg && *msg) {
+        static const char tcc[] = "RUNTIME ERROR: ";
+        if (!strncmp(msg, tcc, sizeof tcc - 1)) msg += sizeof tcc - 1;
+        fprintf(stderr, "goose runtime error: %s\n", msg);
+    }
+    if (func && !strcmp(func, "main")) return 0;
+    string_view path = file ? file : "";
+    auto goose = path.size() > 6 && path.substr(path.size() - 6) == ".goose";
+    if (!func || !file || !strncmp(func, "gs_", 3) || (!goose && !msg)) return 1;
+    auto slash = path.find_last_of("/\\");
+    if (slash != string_view::npos) path = path.substr(slash + 1);
+    fprintf(stderr, "  at %s (%.*s:%d)\n", JitGooseName(func).c_str(), (int)path.size(),
+            path.data(), line);
+    return 1;
+}
+
 // Compiles `csrc` into this process's memory, ready for RunJit. `symbols`
 // holds the C functions of the packages' native parts the program reaches, by
 // name (native.h, builtin.h): from the tables compiled in with builtin
-// packages, or loaded from the libraries built for the others.
+// packages, or loaded from the libraries built for the others. `debug` adds
+// line tables for the C's #line directives and the backtrace JitFrame prints
+// on a crash or an abort; TinyCC has backtraces outside Windows only
+// (cmake/libtcc.cmake).
 inline TCCState *CompileJit(const string &csrc, const string &libpath,
-                            const vector<pair<string, const void *>> &symbols) {
+                            const vector<pair<string, const void *>> &symbols, bool debug) {
     string diags;
     auto s = tcc_new();
     if (!s) throw CompileError { "libtcc: out of memory" };
@@ -53,6 +112,17 @@ inline TCCState *CompileJit(const string &csrc, const string &libpath,
     // this, so it has to be set before the output type that reads them.
     tcc_set_lib_path(s, libpath.c_str());
     tcc_set_options(s, "-nostdinc -nostdlib -Wl,-nostdlib");
+    #ifndef _WIN32
+        // -bt: the line table kept in memory and TinyCC's crash handler, which
+        // walks up to 64 frames; -g1dwarf: line information only, as DWARF,
+        // whose lines are not limited to 16 bits as stabs' are.
+        if (debug) {
+            tcc_set_options(s, "-bt64 -g1dwarf");
+            tcc_set_backtrace_func(s, nullptr, JitFrame);
+        }
+    #else
+        (void)debug;
+    #endif
     tcc_add_sysinclude_path(s, cat(libpath, "/goose/include").c_str());
     tcc_add_sysinclude_path(s, cat(libpath, "/include").c_str());
     auto fail = [&](const char *what) {
@@ -102,8 +172,10 @@ inline int RunJit(TCCState *s, const string &progname, const vector<string> &pro
     argv.push_back(name.data());
     for (auto &a : args) argv.push_back(a.data());
     argv.push_back(nullptr);
+    // Defined only under --debug (CompileJit), for an abort's backtrace.
+    auto walk = tcc_get_symbol(s, "_tcc_backtrace");
     auto code = goose_jit_run(entry, cleanup, (int)argv.size() - 1, argv.data(),
-                              resource_dir.c_str());
+                              resource_dir.c_str(), walk);
     tcc_delete(s);
     return code;
 }
diff --git a/src/jit_runtime.c b/src/jit_runtime.c
index 4862193c..8fcf2b26 100644
--- a/src/jit_runtime.c
+++ b/src/jit_runtime.c
@@ -9,6 +9,7 @@ static jmp_buf gs_jit_jump;
 static int gs_jit_status;
 static const char *gs_jit_resource_dir;
 static void gs_jit_exit(int code);
+static void gs_jit_trace(void);
 
 #define GS_SEPARATE_RUNTIME 1
 #define GS_RUNTIME_OBJECT 1
@@ -26,6 +27,35 @@ static void gs_jit_exit(int code) {
     longjmp(gs_jit_jump, 1);
 }
 
+/* goose run --debug: TinyCC's frame walker (tccrun.c's _tcc_backtrace),
+   which hands each frame from a given one outwards to the callback the
+   compiler installed (src/jit.h); NULL otherwise. The frame is lib/bt-log.c's
+   rt_frame. The frames of this file have no line information and are
+   passed over, so the walk only needs them to keep frame pointers, which
+   CMakeLists.txt asks for where the C compiler would leave them out. */
+typedef struct { void *ip, *fp, *sp; } gs_jit_frame;
+static int (*gs_jit_walk)(gs_jit_frame *, const char *, va_list);
+
+/* The walk starts in this frame. An empty message: gs_fail printed it.
+   MSVC has no __builtin_frame_address, and TinyCC no backtraces on Windows
+   (cmake/libtcc.cmake), so the walker is never there to call. */
+#ifndef _MSC_VER
+static void gs_jit_walk_here(const char *fmt, ...) {
+    gs_jit_frame f = { (void *)gs_jit_walk_here, __builtin_frame_address(0), NULL };
+    va_list ap;
+    va_start(ap, fmt);
+    gs_jit_walk(&f, fmt, ap);
+    va_end(ap);
+}
+#endif
+
+/* After an abort's message (gs_fail), the Goose frames that led to it. */
+static void gs_jit_trace(void) {
+#ifndef _MSC_VER
+    if (gs_jit_walk) gs_jit_walk_here("");
+#endif
+}
+
 #define GS_JIT_SYMBOL(f) { #f, (const void *)f },
 static const GooseJitSymbol gs_jit_symbols[] = {
 #include "jit_symbols.inc"
@@ -106,8 +136,9 @@ static const GooseJitSymbol gs_jit_symbols[] = {
 const GooseJitSymbol *goose_jit_symbols(void) { return gs_jit_symbols; }
 
 int goose_jit_run(int (*entry)(int, char **), void (*cleanup)(void),
-                  int argc, char **argv, const char *resource_dir) {
+                  int argc, char **argv, const char *resource_dir, void *walk) {
     gs_jit_resource_dir = resource_dir;
+    gs_jit_walk = (int (*)(gs_jit_frame *, const char *, va_list))walk;
     gs_thread_cap = INT64_MAX;
     gs_jit_status = 0;
     if (!setjmp(gs_jit_jump)) gs_jit_status = entry(argc, argv);
@@ -118,5 +149,6 @@ int goose_jit_run(int (*entry)(int, char **), void (*cleanup)(void),
     gs_rt_release();
     cleanup();
     gs_jit_resource_dir = NULL;
+    gs_jit_walk = NULL;
     return gs_jit_status;
 }
