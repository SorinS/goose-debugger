 src/main.cpp                 |  2 +-
 src/runtime/runtime_impl.h   |  9 ++++-
 src/runtime_inline.h         |  9 ++++-
 third_party/tinycc/README.md |  9 +++++
 third_party/tinycc/tccelf.c  |  7 ++++
 third_party/tinycc/tccrun.c  | 12 +++---
 13 files changed, 192 insertions(+), 24 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index effd6e4c..1fba481a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -192,6 +192,12 @@ foreach(header runtime.h runtime_ext.h)
 endforeach()
 file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/jit_symbols.inc" CONTENT "${jit_symbols}" @ONLY)
 target_sources(goose PRIVATE src/jit_runtime.c src/jit_runtime.h)
+# goose run --debug walks an abort's stack from inside this file's runtime
+# out to the program's frames by frame pointer (gs_jit_trace).
+if(NOT MSVC)
+    set_source_files_properties(src/jit_runtime.c PROPERTIES
+        COMPILE_OPTIONS -fno-omit-frame-pointer)
+endif()
 target_include_directories(goose PRIVATE "${CMAKE_BINARY_DIR}")
 set_property(TARGET goose PROPERTY C_STANDARD 11)
 
diff --git a/cmake/libtcc.cmake b/cmake/libtcc.cmake
index 31f43809..f9088db3 100644
--- a/cmake/libtcc.cmake
+++ b/cmake/libtcc.cmake
@@ -37,15 +37,23 @@ endif()
 # --- config.h ----------------------------------------------------------------
 # CONFIG_TCC_PREDEFS 0 makes TinyCC read include/tccdefs.h from the staged
 # directory instead of from a string baked in by its own build tools, which are
-# not run here. Bounds checking and backtraces are off: both pull in support
-# objects that need the full Windows SDK headers, which TinyCC does not ship.
+# not run here. Bounds checking is off: it pulls in support objects that need
+# the full Windows SDK headers, which TinyCC does not ship. Backtraces are on
+# outside Windows for goose run --debug (src/jit.h), which uses only the line
+# table and frame walker inside libtcc itself and links none of their support
+# objects; Windows would add bt-log.o to every in-memory run (tccpe.c).
 
 file(READ "${TCC_SRC}/VERSION" tcc_version)
 string(STRIP "${tcc_version}" tcc_version)
+if(WIN32)
+    set(tcc_backtrace 0)
+else()
+    set(tcc_backtrace 1)
+endif()
 set(tcc_config "/* Generated by cmake/libtcc.cmake. */
 #define TCC_VERSION \"${tcc_version}\"
 #define CONFIG_TCC_PREDEFS 0
-#define CONFIG_TCC_BACKTRACE 0
+#define CONFIG_TCC_BACKTRACE ${tcc_backtrace}
 #define CONFIG_TCC_BCHECK 0
 #define CONFIG_TCC_SYSINCLUDEPATHS \"{B}/include\"
 #define CONFIG_TCC_CRTPREFIX \"{B}\"
