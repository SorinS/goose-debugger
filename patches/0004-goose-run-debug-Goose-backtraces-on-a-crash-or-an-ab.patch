+- `tccelf.c`, `tccrun.c`: backtraces for an embedder's in-memory
+  `-nostdlib` run, which `goose run --debug` is (`src/jit.h`).
+  `tcc_add_runtime` adds the `__rt_info` block a backtrace reads under
+  `-nostdlib` too, without `bt-log.o`; `bt_info` holds a file name of up to
+  1023 bytes rather than 99, since `#line` names absolute paths; and the
+  DWARF line lookup charges an address to the file of the row it falls in,
+  not to the file a `DW_LNS_set_file` names for the row after it, which a
+  return address at a function's end used to be charged to.
+
 To update, copy the same files from a newer TinyCC commit and record that
 commit here. Preserve the local changes until they are included upstream.
diff --git a/third_party/tinycc/tccelf.c b/third_party/tinycc/tccelf.c
index def5aebc..5beced8e 100644
--- a/third_party/tinycc/tccelf.c
+++ b/third_party/tinycc/tccelf.c
@@ -1880,6 +1880,13 @@ ST_FUNC void tcc_add_runtime(TCCState *s1)
             tccelf_add_crtend(s1);
 #endif
     }
+#ifdef CONFIG_TCC_BACKTRACE
+    /* An embedder's -nostdlib in-memory run (Goose's JIT) keeps the line
+       table and its __rt_info for tcc_set_backtrace_func; bt-log.o is not
+       linked, the embedder supplies its own frames. */
+    else if (s1->do_backtrace && s1->output_type == TCC_OUTPUT_MEMORY)
+        tcc_add_btstub(s1);
+#endif
 }
 #endif /* ndef TCC_TARGET_PE */
 
diff --git a/third_party/tinycc/tccrun.c b/third_party/tinycc/tccrun.c
index 1003ea5d..5e08fc73 100644
--- a/third_party/tinycc/tccrun.c
+++ b/third_party/tinycc/tccrun.c
@@ -692,7 +692,7 @@ static char *rt_elfsym(rt_context *rc, addr_t wanted_pc, addr_t *func_addr)
 
 typedef struct bt_info
 {
-    char file[100];
+    char file[1024]; /* Goose: #line names absolute paths */
     int line;
     char func[100];
     addr_t func_pc;
@@ -858,9 +858,10 @@ static addr_t rt_printline_dwarf (rt_context *rc, addr_t wanted_pc, bt_info *bi)
     addr_t func_addr;
