index cfa4bc34..719b0919 100644
--- a/src/jit_runtime.h
+++ b/src/jit_runtime.h
@@ -10,8 +10,10 @@ typedef struct {
 } GooseJitSymbol;
 
 const GooseJitSymbol *goose_jit_symbols(void);
+/* `walk` is TinyCC's _tcc_backtrace under goose run --debug, which an
