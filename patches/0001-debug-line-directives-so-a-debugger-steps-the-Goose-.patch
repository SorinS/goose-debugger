diff --git a/src/codegen.h b/src/codegen.h
index 7eccd4f5..c3bcbaa2 100644
--- a/src/codegen.h
+++ b/src/codegen.h
@@ -186,6 +186,45 @@ struct CodeGen {
     // and the checks' cost can be priced (--unsafe-no-rf-check).
     bool norfcheck = false;
 
+    // --debug: every line of a function's C is preceded by a #line naming
+    // the Goose statement it came from, so a debugger shows and steps the
+    // Goose source. One directive per C line, not per statement: after
+    // `#line N` the next C lines would count on as N+1, N+2. A function
+    // ends with LINE_RESET, which ResetLines turns into a #line back to
+    // the C file itself, so what follows is not charged to Goose.
+    bool linedirs = false;
+    Line srcline;                        // The statement being emitted; line 0 = none.
+    map<int, string> linefiles;          // fileidx -> its #line file literal.
+    static constexpr const char *LINE_RESET = "#line @@gs_reset";
+
+    string LineFile(int fileidx) {
+        auto it = linefiles.find(fileidx);
+        if (it != linefiles.end()) return it->second;
+        string f = fileidx >= 0 && fileidx < (int)ast.sources.size()
+                       ? ast.sources[fileidx].first : string("?");
+        std::error_code ec;
+        auto abs = filesystem::absolute(filesystem::path(f), ec);
+        if (!ec) f = abs.lexically_normal().generic_string();
+        return linefiles.emplace(fileidx, CStr(f)).first->second;
+    }
+    void LineDir(string &s, Line l) {
+        if (linedirs && l.line > 0) Append(s, "#line ", l.line, " ", LineFile(l.fileidx), "\n");
+    }
+    // The assembled C with each LINE_RESET replaced by a #line that gives
+    // the following lines their own numbers in `cfile` again.
+    static string ResetLines(const string &c, const string &cfile) {
+        string out, name = CStr(cfile), mark = cat(LINE_RESET, "\n");
+        out.reserve(c.size());
+        size_t ln = 1;
+        for (size_t pos = 0, nl; pos < c.size(); pos = nl + 1, ln++) {
+            nl = c.find('\n', pos);
+            if (nl == string::npos) nl = c.size() - 1;
+            if (c.compare(pos, nl + 1 - pos, mark) == 0) Append(out, "#line ", ln + 1, " ", name, "\n");
+            else out.append(c, pos, nl + 1 - pos);
+        }
+        return out;
+    }
+
     [[noreturn]] void Fail(Line l, const string &msg) {
         auto s = cat("codegen: ", msg);
         if (l.fileidx >= 0 && l.fileidx < (int)ast.sources.size())
@@ -670,6 +709,7 @@ struct CodeGen {
     // calls therefore never share an argument list (or any one expression):
     // the earlier goes to a local of its own first.
     template<typename... Ts> void L(const Ts &...args) {
+        LineDir(body, srcline);
         body.append((size_t)ind * 4, ' ');
         Append(body, args...);
         body += '\n';
@@ -1598,9 +1638,9 @@ struct CodeGen {
     // A function the extern support declares gets no prototype here.
     CodeGen(Ast &_ast, string_view runtime_ext_text, const vector<string> &headers,
             bool _norfcheck = false, bool _library = false, bool _sharedlibrary = false,
-            int64_t _maxstacks = 0)
+            int64_t _maxstacks = 0, bool _linedirs = false)
         : ast(_ast), library(_library), sharedlibrary(_sharedlibrary),
-          norfcheck(_norfcheck), maxstacks(_maxstacks) {
+          norfcheck(_norfcheck), linedirs(_linedirs), maxstacks(_maxstacks) {
         for (auto t : ast.alltypes)
             if (t->kind == TY_REF && t->ref->pool) poolglobals.insert(t->ref->pool);
         ComputeRelRootMax();
diff --git a/src/codegen_emit.h b/src/codegen_emit.h
index db8950e6..f821aa5d 100644
--- a/src/codegen_emit.h
+++ b/src/codegen_emit.h
@@ -614,6 +614,9 @@ inline void CodeGen::EmitSpec(FnSpec *sp, bool er) {
     FindRefAliases(sp);
     PlanTopClasses(sp);
     markers = true;
+    // The prologue is the declaration's line, where a breakpoint on the
+    // function stops.
+    srcline = sp->sf->line;
     PushSc(SC_FN);
     auto params = SigParams(sp, true, er);
     // The spellings are only known once SigParams has named the parameters.
@@ -706,11 +709,24 @@ inline void CodeGen::EmitSpec(FnSpec *sp, bool er) {
     // main runs before anything else, so these are final on entry.
     for (auto &p : poolbases)
         Append(fnbody, "    uint8_t *", p.second, " = ", gnames[p.first], ".base;\n");
+    if (linedirs) {   // The prologue's lines are the declaration's.
+        string pro;
+        for (size_t pos = 0, nl; pos < fnbody.size(); pos = nl + 1) {
+            nl = fnbody.find('\n', pos);
+            if (nl == string::npos) nl = fnbody.size() - 1;
+            LineDir(pro, sp->sf->line);
+            pro.append(fnbody, pos, nl + 1 - pos);
+        }
+        fnbody = pro;
+    }
     fnbody += bodyout;
     auto name = er ? ernames[sp] : curinfo->cname;
+    LineDir(code, sp->sf->line);
     if (sp->sf->issimd) EmitSimdVersions(sp, name, params, fnbody);
     else Append(code, "static ", FnAttrs(sp), SigRet(sp), " ", name, "(", params, ") {\n", fnbody,
                 "}\n\n");
+    if (linedirs) Append(code, LINE_RESET, "\n");
+    srcline = Line {};
     curspec = nullptr;
     curinfo = nullptr;
     emiter = false;
